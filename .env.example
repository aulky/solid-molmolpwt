# Konfigurasi Lingkungan Mol-Mol Purwokerto

# Port & URL Aplikasi
PORT=3001
BASE_URL="http://localhost:3001"

# Database MySQL
# Format Connection String: mysql://user:password@host:port/database
# Atau gunakan parameter individual di bawah ini:
DATABASE_URL="mysql://root:password@127.0.0.1:3306/molmol_db"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="molmol_db"

# Kredensial Admin Awal (Digunakan saat seed database)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="AdminMolMolPurwokerto2026!"
DEFAULT_ADMIN_NAME="Owner Mol-Mol"

# Session Secret (Minimal 32 karakter acak untuk keamanan auth cookie)
ADMIN_SESSION_SECRET="molmol-purwokerto-super-secret-session-key-change-this-in-production-2026"

# Notifikasi Telegram Bot (Opsional saat lokal, wajib saat produksi)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_SECRET_TOKEN=""

# Pengaturan Toko & Ongkir Awal
STORE_NAME="Mol-Mol Purwokerto"
STORE_TAGLINE="Camilan Manis & Gurih Khas Purwokerto — Sistem Pre-Order Berkala"
ADMIN_PHONE="6281234567890"
FLAT_DELIVERY_FEE=10000
FREE_DELIVERY_MIN=75000
